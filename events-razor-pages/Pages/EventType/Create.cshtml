@page
@model events_razor_pages.Pages_EventType.CreateModel

        @{
        ViewData["Title"] = "Nova vrsta događaja";
        }
        
        <h1><i class="bi bi-plus-circle"></i> Nova vrsta događaja</h1>
        <h4>Vrsta događaja</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EventType.Naziv" class="control-label"></label>
                <input asp-for="EventType.Naziv" class="form-control" />
                <span asp-validation-for="EventType.Naziv" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EventType.Opis" class="control-label"></label>
                <input asp-for="EventType.Opis" class="form-control" />
                <span asp-validation-for="EventType.Opis" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EventType.MinimalnoPolaznika" class="control-label"></label>
                <input asp-for="EventType.MinimalnoPolaznika" class="form-control" />
                <span asp-validation-for="EventType.MinimalnoPolaznika" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kreiraj" class="btn btn-primary me-2" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Nazad</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
