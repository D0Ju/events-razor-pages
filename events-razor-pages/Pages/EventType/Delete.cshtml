@page
@model events_razor_pages.Pages_EventType.DeleteModel

@{
    ViewData["Title"] = "Obriši vrstu";
}

<h1><i class="bi bi-trash"></i> Obriši vrstu događaja</h1>

<h3 class="text-danger">Jeste li sigurni da želite obrisati ovu vrstu?</h3>
<div>
    <h4>Vrsta događaja</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventType.Naziv)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventType.Naziv)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventType.Opis)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventType.Opis)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EventType.MinimalnoPolaznika)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EventType.MinimalnoPolaznika)
        </dd>
    </dl>
    
    <form method="post" class="mt-3">
        <input type="hidden" asp-for="EventType.Id" />
        <input type="submit" value="Obriši" class="btn btn-danger me-2" />
        <a asp-page="./Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Otkaži</a>
    </form>
</div>
