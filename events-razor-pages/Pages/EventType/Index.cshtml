@page
@model events_razor_pages.Pages_EventType.IndexModel

@{
    ViewData["Title"] = "Vrste događaja";
}

<h1><i class="bi bi-list"></i> Vrste događaja</h1>

<p>
    <a asp-page="Create" class="btn btn-primary mb-3"><i class="bi bi-plus-circle"></i> Nova vrsta</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventType[0].Naziv)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventType[0].Opis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventType[0].MinimalnoPolaznika)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.EventType) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Naziv)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opis)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MinimalnoPolaznika)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
