@page
@model events_razor_pages.Pages_Event.DetailsModel

@{
    ViewData["Title"] = "Detalji događaja";
}

<h1><i class="bi bi-info-circle"></i> Detalji događaja</h1>

<div>
    <h4>Događaj</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.Naziv)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.Naziv)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.Lokacija)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.Lokacija)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.DatumPocetka)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.DatumPocetka)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.DatumZavrsetka)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.DatumZavrsetka)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.BrojPolaznika)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.BrojPolaznika)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.Cijena)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.Cijena)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.Opis)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.Opis)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.Aktivan)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.Aktivan)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event.VrstaId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.VrstaId)
        </dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-page="./Edit" asp-route-id="@Model.Event.Id" class="btn btn-warning btn-sm me-2"><i class="bi bi-pencil"></i> Uredi</a>
    <a asp-page="./Index" class="btn btn-secondary btn-sm"><i class="bi bi-arrow-left"></i> Nazad</a>
</div>
