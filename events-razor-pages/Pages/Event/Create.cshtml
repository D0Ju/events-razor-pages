@page
@model events_razor_pages.Pages_Event.CreateModel

        @{
            ViewData["Title"] = "Kreiraj novi događaj";
        }
        
        <h1><i class="bi bi-plus-circle"></i> Kreiraj novi događaj</h1>
        <h4>Novi događaj</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Event.Naziv" class="control-label"></label>
                <input asp-for="Event.Naziv" class="form-control" />
                <span asp-validation-for="Event.Naziv" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.Lokacija" class="control-label"></label>
                <input asp-for="Event.Lokacija" class="form-control" />
                <span asp-validation-for="Event.Lokacija" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.DatumPocetka" class="control-label"></label>
                <input asp-for="Event.DatumPocetka" class="form-control"  type="date"/>
                <span asp-validation-for="Event.DatumPocetka" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.DatumZavrsetka" class="control-label"></label>
                <input asp-for="Event.DatumZavrsetka" class="form-control" type="date" />
                <span asp-validation-for="Event.DatumZavrsetka" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.BrojPolaznika" class="control-label"></label>
                <input asp-for="Event.BrojPolaznika" class="form-control" />
                <span asp-validation-for="Event.BrojPolaznika" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.Cijena" class="control-label"></label>
                <input asp-for="Event.Cijena" class="form-control" />
                <span asp-validation-for="Event.Cijena" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.Opis" class="control-label"></label>
                <input asp-for="Event.Opis" class="form-control" />
                <span asp-validation-for="Event.Opis" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Event.Aktivan" /> @Html.DisplayNameFor(model => model.Event.Aktivan)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Event.VrstaId" class="control-label">Vrsta događaja</label>
                <select asp-for="Event.VrstaId" asp-items="@Model.VrstaList" class="form-select">
                    <option value="">-- Odaberi vrstu --</option>
                </select>
                <span asp-validation-for="Event.VrstaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kreiraj" class="btn btn-primary me-2" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Nazad na sve događaje</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
