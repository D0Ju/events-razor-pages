@page "{vrstaId:int}"
@model events_razor_pages.Pages_Event.FilterByTypeModel
@{
    ViewData["Title"] = "Filtriraj događaje po vrsti";
}

<div class="container mt-5">
    <h1>Filtrirani Događaji</h1>
    <p class="text-muted">Vrsta: <strong>@Model.VrstaName</strong></p>

    @if (Model.Events.Count() > 0)
    {
        <div class="row">
            @foreach (var dogadaj in Model.Events)
            {
                <partial name="_DogađajCard" model="dogadaj" />
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Nema događaja za ovu vrstu.
        </div>
    }

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-secondary">Nazad na sve događaje</a>
    </div>
</div>
